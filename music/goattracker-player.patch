--- player.s.orig	2026-10-16 15:24:29
+++ player.s	2026-10-28 23:26:02
@@ -594,6 +594,7 @@
                 sta mt_filtctrl+1             ;Switch filter off & reset
               .IF (NOFILTER == 0)
                 sta mt_filtstep+1             ;step-programming
+                sta mt_filtheld+1             ;LEST patch: the filter HELD again (see mt_filtheld)
               .ENDIF
                 stx mt_initsongnum+1          ;Reset initflag
                 tax
@@ -627,6 +628,8 @@
               .IF (NOFILTER == 0)
                 ldy #$00                        ;See if filter stopped
                 beq mt_filtdone
